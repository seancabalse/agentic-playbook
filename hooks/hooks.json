{
  "description": "SessionStart: tells Claude where the playbook is and which files the project overrides, and whether its branch is behind the team branch. PreToolUse (Bash): blocks AI attribution in commits and PRs, and secrets in commits; before a commit or push, warns when a rebase onto the team branch would conflict.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/branch-sync-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-commit.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/branch-sync-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
